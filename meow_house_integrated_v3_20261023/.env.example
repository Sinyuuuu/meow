# Runtime
APP_NAME=Meow一下
APP_SECRET_KEY=please-change-this-for-any-shared-demo
# 專案內資料庫（相對路徑會固定從專案根目錄解析）
DATABASE_URL=sqlite:///./database/app.db
# 若要讓多個專案版本共用同一份持久資料，改用專案外的絕對路徑，例如：
# DATABASE_URL=sqlite:///C:/Users/your-name/Documents/Codex/MeowHouseData/app.db
APP_TIMEZONE=Asia/Taipei
# 留白時一鍵啟動器會自動尋找可用 port
APP_PORT=
# 遠端攝影機或邊緣裝置要回報資料時才需要設定；請勿使用範例值上線
MEOW_SERVICE_KEY=

# AI monitor
CAMERA_SOURCE=0
YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE=0.35
YOLO_IMAGE_SIZE=960
# center 適合初始 Demo；實際地面區域可改成 bottom_center
ZONE_POINT_MODE=center
ZONE_SWITCH_SECONDS=2.0
MISSING_CAT_ALERT_SECONDS=30
LONG_STAY_ALERT_SECONDS=3600
MONITOR_SAMPLE_FPS=8
DEFAULT_PET_ID=1
ROI_CONFIG_PATH=data/rois.json
