{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "安裝專案套件",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "pip",
        "install",
        "-r",
        "requirements.txt"
      ],
      "problemMatcher": []
    },
    {
      "label": "執行自動測試",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "pytest",
        "-q"
      ],
      "group": "test",
      "problemMatcher": []
    }
  ]
}
